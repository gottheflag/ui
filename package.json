{
	"name": "@gottheflag/ui",
	"version": "0.1.0-beta.1",
	"type": "module",
	"packageManager": "pnpm@12.5.1",
	"author": {
		"name": "GTF",
		"email": "dev@gottheflag.sa",
		"url": "https://gottheflag.sa"
	},
	"description": "Pure CSS UI components library",
	"license": "Apache-2.0",
	"style": "./dist/index.css",
	"sideEffects": [
		"**/*.css"
	],
	"files": [
		"dist"
	],
	"exports": {
		".": "./dist/index.css",
		"./index.css": "./dist/index.css",
		"./*.css": "./dist/*/index.css",
		"./*": "./dist/*/index.css",
		"./package.json": "./package.json"
	},
	"scripts": {
		"clean:dist": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
		"playground": "vite playground",
		"build": "pnpm run clean:dist && sass src:dist --no-source-map --style=compressed",
		"build:expanded": "pnpm run clean:dist && sass src:dist --no-source-map --style=expanded",
		"prepack": "pnpm run build"
	},
	"keywords": [
		"css",
		"ui",
		"components",
		"design",
		"system",
		"library"
	],
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/gottheflag/ui"
	},
	"bugs": {
		"url": "https://github.com/gottheflag/ui/issues"
	},
	"homepage": "https://github.com/gottheflag/ui#readme",
	"devDependencies": {
		"@gottheflag/nova": "0.1.0-beta.4",
		"@gottheflag/shortcut": "0.1.0-beta.2",
		"esbuild": "^0.28.1",
		"sass": "^1.102.0",
		"vite": "^7.3.6"
	}
}
